<div class="dashboard-container">
  <!-- メニューバー -->
   <div class="sidebar">
    <ul>
      <li><a href="#">ユーザー／ゲスト</a></li>
      <li><a href="#">スケジュール</a></li>
      <li><a href="#">リスト</a></li>
    </ul>
   </div>

  <!-- メイン画面 -->
  <div class="main-content">
    <!-- 検索フォーム -->
    <div class="search-form">
      <h3>ユーザー検索</h3>
      <%= search_form_for @q_users, url:admin_dashboards_path do |f| %>
        <%= f.label :name_cont, "名前" %>
        <%= f.text_field :name_cont, placeholder: "Name" %>
        <%= f.label :email_cont, "メールアドレス" %>
        <%= f.text_field :email_cont, placeholder: "email" %>
        <%= f.submit "検索" %>
      <% end %>
      <h3>ゲスト検索</h3>
      <%= search_form_for @q_guests, url:admin_dashboards_path do |f| %>
        <%= f.label :name_cont, "名前" %>
        <%= f.text_field :name_cont, placeholder: "Name" %>
        <%= f.label :email_cont, "メールアドレス" %>
        <%= f.text_field :email_cont, placeholder: "email" %>
      <%= f.submit "検索" %>
    <% end %>
    </div>

    <!-- データ画面 -->
      <div class="data-table">
        <div class="table_A">
          <h3>ユーザー</h3>
          <table>
            <thead>
              <tr>
                <th>名前</th>
                <th>メールアドレス</th>
              </tr>
            </thead>
            <tbody>
              <% @users.each do |user| %>
                <tr>
                  <td><%= user.name %></td>
                  <td><%= user.email %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <%= paginate @users, param_name: :page_users %>
        </div>

        <div class="table_B">
          <h3>ゲスト</h3>
          <table>
            <thead>
              <tr>
                <th>名前</th>
                <th>メールアドレス</th>
                <th>紹介者 ID</th>
                <th>紹介者 Name</th>
              </tr>
            </thead>
            <tbody>
              <% @guests.each do |guest| %>
                <tr>
                  <td><%= guest.name %></td>
                  <td><%= guest.email %></td>
                  <td><%= guest.user_id %></td>
                  <td><%= guest.user.name %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <%= paginate @guests, param_name: :page_guests %>
        </div>
      </div>
  </div>
</div>
